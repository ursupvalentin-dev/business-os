      "formulas": [
        {
          "col": "B",
          "range_rows": [
            2,
            27
          ],
          "formula": "=IF(AND(ISNUMBER('Start Here'!$C$5),'Start Here'!$C$5>=DATE(2000,1,1)),'Start Here'!$C$5+14*(A{row}-1),\"\")"
        },
        {
          "col": "C",
          "range_rows": [
            2,
            27
          ],
          "formula": "=IF(B{row}=\"\",\"\",INT((DAY(B{row})-1)/14)+1)"
        },
        {
          "col": "E",
          "range_rows": [
            2,
            27
          ],
          "formula": "=IF(OR(C{row}=\"\",C{row}=3),0,SUMIF(Bills!$E:$E,C{row},Bills!$D:$D))"
        },
        {
          "col": "G",
          "range_rows": [
            2,
            27
          ],
          "formula": "=IF(ISNUMBER(D{row}),D{row},0)-E{row}-IF(ISNUMBER(F{row}),F{row},0)"
        },
        {
          "col": "I",
          "range_rows": [
            2,
            27
          ],
          "formula": "=IF(H{row}=\"\",\"\",IF(ISNUMBER(H{row}),ROUND(G{row}-H{row},2),\"Not a number\"))"
        },
        {
          "col": "J",
          "range_rows": [
            2,
            27
          ],
          "formula": "=IF(B{row}=\"\",\"Set your first payday on Start Here\",IF(D{row}=\"\",\"Enter take-home pay\",IF(OR(NOT(ISNUMBER(D{row})),D{row}<0,AND(F{row}<>\"\",NOT(ISNUMBER(F{row}))),AND(ISNUMBER(F{row}),F{row}<0)),\"Pay and savings must be numbers, not text or negatives\",IF(ROUND(G{row},2)<0,\"Short: bills + savings exceed pay\",IF(C{row}=3,\"Extra paycheck: no bills due\",\"\")))))"
        }
      ],
