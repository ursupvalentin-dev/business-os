      "formulas": [
        {
          "cell": "B5",
          "formula": "First payday (type your own date here)"
        },
        {
          "cell": "C5",
          "formula": "=DATE(2026,10,9)",
          "number_format": "mmm d, yyyy"
        },
        {
          "cell": "B6",
          "formula": "Last payday in this tracker"
        },
        {
          "cell": "C6",
          "formula": "=IF(AND(ISNUMBER(C5),C5>=DATE(2000,1,1)),MAX(Paychecks!$B$2:$B$27),\"\")",
          "number_format": "mmm d, yyyy"
        },
        {
          "cell": "B7",
          "formula": "Extra paychecks in this window (3rd payday in a month)"
        },
        {
          "cell": "C7",
          "formula": "=IF(AND(ISNUMBER(C5),C5>=DATE(2000,1,1)),COUNTIF(Paychecks!$C$2:$C$27,3),\"\")",
          "number_format": "0"
        },
        {
          "cell": "B10",
          "formula": "1. Set your first payday above; the other 25 paydays fill in every 14 days."
        },
        {
          "cell": "B11",
          "formula": "2. Bills tab: list each monthly bill with its category, due day and amount."
        },
        {
          "cell": "B12",
          "formula": "3. Tag each bill 1 or 2, the paycheck that arrives before it's due:"
        },
        {
          "cell": "B13",
          "formula": "      1 = first payday of the month (1st-14th), 2 = second payday (15th-28th)."
        },
        {
          "cell": "B14",
          "formula": "      Bills due the 1st-14th usually come out of the previous month's check 2."
        },
        {
          "cell": "B15",
          "formula": "      A 3rd payday in a month is an extra paycheck: no bills come out of it."
        },
        {
          "cell": "B16",
          "formula": "4. Paychecks tab: yellow cells are yours. Enter Take-Home Pay and Savings in dollars,"
        },
        {
          "cell": "B17",
          "formula": "      and log what you actually spend in Spent as each pay period goes by."
        },
        {
          "cell": "B18",
          "formula": "5. Red cells flag something to fix. Keep the # column as is: it sets each date."
        },
        {
          "cell": "B19",
          "formula": "6. Dashboard tab: totals for all 26 paychecks and your monthly bills by category."
        }
      ],
      "conditional_formats": [
        {
          "range": "C5",
          "type": "formula",
          "formula": [
            "NOT(AND(ISNUMBER($C$5),$C$5>=DATE(2000,1,1)))"
          ],
          "fill": "FFC7CE"
        }
