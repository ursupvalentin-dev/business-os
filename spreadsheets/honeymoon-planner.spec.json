   "formulas": [
    {
     "cell": "B3",
     "formula": "Plan the trip of a lifetime without the money stress."
    },
    {
     "cell": "B6",
     "formula": "Trip: your names, destination, travel dates and what you've already saved."
    },
    {
     "cell": "B7",
     "formula": "Budget: estimate each cost. Once booked, type the real price, what you've paid and when the rest is due."
    },
    {
     "cell": "B8",
     "formula": "Savings: log what you put away. Gift Fund: log honeymoon registry gifts and tick thank-yous."
    },
    {
     "cell": "B9",
     "formula": "Itinerary: plan each day. Packing: tick things off as they go in the suitcase."
    },
    {
     "cell": "B10",
     "formula": "Dashboard: days to go, money still to raise, vendor balances due, gifts and packing progress."
    },
    {
     "cell": "B13",
     "formula": "Booked price wins"
    },
    {
     "cell": "C13",
     "formula": "Once you type the real price, it replaces the estimate."
    },
    {
     "cell": "B14",
     "formula": "Due dates"
    },
    {
     "cell": "C14",
     "formula": "Resorts often want the balance 30 to 60 days before you arrive."
    },
    {
     "cell": "B15",
     "formula": "Gift fund"
    },
    {
     "cell": "C15",
     "formula": "Tell guests what their gift paid for in your thank-you card."
    },
    {
     "cell": "B16",
     "formula": "Passports"
    },
    {
     "cell": "C16",
     "formula": "Check expiry dates: many countries need 6 months left."
    },
    {
     "cell": "C19",
     "formula": "White cells are for typing."
    },
    {
     "cell": "C20",
     "formula": "Grey cells calculate."
    },
    {
     "cell": "C21",
     "formula": "Green = paid in full / done."
    },
    {
     "cell": "C22",
     "formula": "Red = payment due soon or overdue."
    },
    {
     "cell": "B24",
     "formula": "Here's to the two of you."
    }
