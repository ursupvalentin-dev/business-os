   "formulas": [
    {
     "cell": "B3",
     "formula": "=IF('Trip'!$R$4=\"\",\"Our\",'Trip'!$R$4&\"'s\")&\" honeymoon\"&IF('Trip'!$R$5=\"\",\"\",\" in \"&'Trip'!$R$5)&IF('Trip'!$R$6=\"\",\"\",\"  |  \"&TEXT('Trip'!$R$6,\"mmm d, yyyy\"))"
    },
    {
     "cell": "R4",
     "formula": "=ROUND('Trip'!$R$9+SUM('Savings'!$H$6:$H$205),2)",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R5",
     "formula": "=ROUND(SUMIFS('Gift Fund'!$D$6:$D$85,'Gift Fund'!$G$6:$G$85,1),2)",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R6",
     "formula": "=ROUND(R4+R5,2)",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R7",
     "formula": "=MAX(0,ROUND('Budget'!$G$30-R6,2))",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R8",
     "formula": "=IF('Trip'!$R$11=\"\",\"\",MAX(1,INT('Trip'!$R$11/7)))"
    },
    {
     "cell": "R9",
     "formula": "=IF('Budget'!$G$30>0,MIN(1,R6/'Budget'!$G$30),0)",
     "number_format": "0%"
    },
    {
     "cell": "R10",
     "formula": "=COUNTIF('Packing'!$G$6:$G$65,1)"
    },
    {
     "cell": "R11",
     "formula": "=COUNTIFS('Packing'!$G$6:$G$65,1,'Packing'!$E$6:$E$65,TRUE)"
    },
    {
     "cell": "R12",
     "formula": "=COUNTIF('Budget'!$J$6:$J$29,\"Overdue\")+COUNTIF('Budget'!$J$6:$J$29,\"Due soon\")"
    },
    {
     "cell": "B13",
     "formula": "=REPT(\"█\",ROUND(MIN(1,MAX(0,R9))*10,0))&REPT(\"░\",10-ROUND(MIN(1,MAX(0,R9))*10,0))&\"  \"&TEXT(R9,\"0%\")&\" of the trip is covered\""
    },
    {
     "cell": "B14",
     "formula": "=IF('Budget'!$G$30<=0,\"Add your costs on the Budget tab.\",IF(R12>0,R12&IF(R12=1,\" payment is\",\" payments are\")&\" due within 30 days (or late). See the Budget tab.\",IF(R7=0,\"Fully funded. Time to relax!\",\"Packing: \"&R11&\" of \"&R10&\" items done.\")))"
    },
