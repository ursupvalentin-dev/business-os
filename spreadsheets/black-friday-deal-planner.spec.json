    {
     "col": "R",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(TRIM(B{row}&\"\")=\"\",0,IF(TRIM(J{row}&\"\")=\"\",1,IFERROR(MATCH(LOWER(TRIM(J{row}&\"\")),{\"watching\",\"bought\",\"skipped\"},0),1)))"
    },
    {
     "col": "S",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(TRIM(F{row}&\"\")=\"\",2,IFERROR(MATCH(LOWER(TRIM(F{row}&\"\")),{\"must have\",\"nice to have\",\"maybe\"},0),2))"
    },
    {
     "col": "T",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(TRIM(E{row}&\"\")=\"\",0,IFERROR(MATCH(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(LOWER(TRIM(E{row}&\"\")),\"~\",\"~~\"),\"*\",\"~*\"),\"?\",\"~?\"),'Stores'!$R$6:$R$20,0),0))"
    },
    {
     "col": "L",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(AND(ISNUMBER(G{row}),G{row}>0,ISNUMBER(I{row})),MAX(0,1-I{row}/G{row}),\"\")",
     "number_format": "0%"
    },
    {
     "col": "M",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(R{row}=0,\"\",IF(R{row}=2,\"Bought\",IF(R{row}=3,\"Skipped\",IF(NOT(ISNUMBER(I{row})),\"Waiting for a deal\",IF(AND(ISNUMBER(H{row}),I{row}<=H{row}),\"Buy now\",\"Wait\")))))"
    },
    {
     "col": "N",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(OR(R{row}=0,R{row}=3),0,ROUND(IF(ISNUMBER(I{row}),I{row},IF(ISNUMBER(H{row}),H{row},N(G{row}))),2))",
     "number_format": "$#,##0.00"
    },
    {
     "col": "O",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(AND(R{row}=2,ISNUMBER(G{row}),ISNUMBER(I{row})),MAX(0,ROUND(G{row}-I{row},2)),0)",
     "number_format": "$#,##0.00"
    },
    {
     "col": "P",
     "range_rows": [
      6,
      65
     ],
     "formula": "=IF(AND(R{row}=2,ISNUMBER(K{row}),N(K{row})>=1,T{row}>0),IF(ISNUMBER(INDEX('Stores'!$D$6:$D$20,T{row})),INT(K{row})+INDEX('Stores'!$D$6:$D$20,T{row}),\"\"),\"\")",
