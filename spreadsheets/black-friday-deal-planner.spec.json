   "formulas": [
    {
     "cell": "B3",
     "formula": "Shop the sales with a plan, a budget and a target price for everything."
    },
    {
     "cell": "B6",
     "formula": "Setup: the year and your total budget. Black Friday and Cyber Monday dates fill themselves in."
    },
    {
     "cell": "B7",
     "formula": "Wish List: everything you want, with the regular price and the most you'd pay (your target)."
    },
    {
     "cell": "B8",
     "formula": "As sales go live, type the deal price. 'Buy now' shows when it hits your target."
    },
    {
     "cell": "B9",
     "formula": "Mark Bought (with the date) or Skipped. Return-by dates use each store's return window."
    },
    {
     "cell": "B10",
     "formula": "Stores: sale start dates, return windows and free-shipping minimums."
    },
    {
     "cell": "B13",
     "formula": "Set targets early"
    },
    {
     "cell": "C13",
     "formula": "Decide your max price before the hype. It stops impulse buys."
    },
    {
     "cell": "B14",
     "formula": "Must haves first"
    },
    {
     "cell": "C14",
     "formula": "Budget for must haves, then add nice-to-haves if there's room."
    },
    {
     "cell": "B15",
     "formula": "Price history"
    },
    {
     "cell": "C15",
     "formula": "A 'sale' isn't always a deal. Compare with the regular price."
    },
    {
     "cell": "B16",
     "formula": "Return windows"
    },
    {
     "cell": "C16",
     "formula": "Holiday returns are often extended. Note it on the Stores tab."
    },
    {
     "cell": "C19",
     "formula": "White cells are for typing."
    },
    {
     "cell": "C20",
     "formula": "Grey cells calculate."
    },
    {
     "cell": "C21",
     "formula": "Green = buy now / bought / great deal."
    },
    {
     "cell": "C22",
     "formula": "Red = over budget or return closing."
    },
    {
     "cell": "B24",
     "formula": "Happy hunting!"
    }
