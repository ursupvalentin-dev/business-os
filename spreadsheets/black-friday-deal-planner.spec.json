    },
    {
     "cell": "R5",
     "formula": "=IF(AND(ISNUMBER(C6),N(C6)>=1),INT(C6),TODAY())",
     "number_format": "mmm d, yyyy"
    },
    {
     "cell": "R4",
     "formula": "=IF(AND(ISNUMBER(C5),N(C5)>=1900,N(C5)<=9999),INT(C5),YEAR(R5))"
    },
    {
     "cell": "R6",
     "formula": "=IF(ISNUMBER(C7),MAX(0,C7),0)",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R7",
     "formula": "=DATE(R4,11,1)+MOD(5-WEEKDAY(DATE(R4,11,1)),7)+22",
     "number_format": "mmm d, yyyy"
    },
