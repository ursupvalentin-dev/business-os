   "formulas": [
    {
     "cell": "B3",
     "formula": "=\"Black Friday \"&'Setup'!$R$4&\"  |  \"&TEXT('Setup'!$R$7,\"ddd, mmm d\")&\"  |  Cyber Monday \"&TEXT('Setup'!$R$8,\"mmm d\")"
    },
    {
     "cell": "R4",
     "formula": "='Wish List'!N66",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R5",
     "formula": "=ROUND(SUMIFS('Wish List'!$N$6:$N$65,'Wish List'!$R$6:$R$65,2),2)",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R6",
     "formula": "='Wish List'!O66",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "R7",
     "formula": "=COUNTIF('Wish List'!$M$6:$M$65,\"Buy now\")"
    },
    {
     "cell": "R8",
     "formula": "=COUNTIFS('Wish List'!$U$6:$U$65,\">=0\",'Wish List'!$U$6:$U$65,\"<=7\")"
    },
    {
     "cell": "R9",
     "formula": "=ROUND('Setup'!$R$6-R4,2)",
     "number_format": "$#,##0.00;-$#,##0.00;$0.00"
    },
    {
     "cell": "R10",
     "formula": "='Setup'!$R$7-'Setup'!$R$5"
    },
    {
     "cell": "R11",
     "formula": "=ROUND(SUMIFS('Wish List'!$N$6:$N$65,'Wish List'!$S$6:$S$65,1),2)",
     "number_format": "$#,##0.00"
    },
    {
     "cell": "B13",
     "formula": "=REPT(\"█\",ROUND(MIN(1,MAX(0,IF('Setup'!$R$6>0,R5/'Setup'!$R$6,0)))*10,0))&REPT(\"░\",10-ROUND(MIN(1,MAX(0,IF('Setup'!$R$6>0,R5/'Setup'!$R$6,0)))*10,0))&\"  \"&TEXT(IF('Setup'!$R$6>0,R5/'Setup'!$R$6,0),\"0%\")&\" of the budget spent\""
    },
    {
     "cell": "B14",
     "formula": "=IF(R9<0,\"Your plan is \"&TEXT(-R9,\"$#,##0\")&\" over budget. Skip a Maybe or two.\",IF(R7>0,R7&IF(R7=1,\" deal has\",\" deals have\")&\" hit your target. Go get it!\",IF(R8>0,R8&IF(R8=1,\" return window closes\",\" return windows close\")&\" within a week.\",\"On plan. Happy hunting!\")))"
